# Copy to .env and fill in. Never commit .env.
#
# The site keeps no data: it renders the Markdown of content/ and the reference
# tables embedded in the binary. It therefore needs no database and no Redis,
# and the local PostgreSQL / Redis rule of the workspace does not apply to it.
# The framework still opens a database handle at boot; it is an in-memory SQLite
# that nothing writes to. If this site ever stores anything, create the database
# ypy_site_dev and give Redis its own index and the key prefix ypysite: here.

# --- the application ---------------------------------------------------------
APP_NAME=YPY
APP_ENV=dev
# The public origin. Every absolute address the site writes -- canonical links,
# the sitemap, llms.txt -- is built from it.
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC
APP_LOCALE=en
# 32 random bytes. `aru key:generate`, or any 32-character secret in development.
APP_KEY=
HTTP_ADDR=:8080
HTTP_MAX_BODY_BYTES=
TRUSTED_PROXIES=
LOG_LEVEL=info
LOG_FORMAT=

# --- the framework's handle on a database -------------------------------------
DATABASE_URL=sqlite://file::memory:?cache=shared

# --- the site -----------------------------------------------------------------
# The folder of Markdown files. Empty means content/ next to go.mod.
CONTENT_DIR=
# Crawlers may index the site. Empty means: only when APP_ENV=prod. When it is
# on, APP_URL has to be an https origin (https://ypy.dev) or the site does not
# start. robots.txt, sitemap.xml, llms.txt and llms-full.txt, the canonical
# addresses and the social cards are all built from APP_URL.
SITE_INDEXING=
# Production also needs (the framework refuses to start without them):
#   APP_ENV=prod  APP_URL=https://ypy.dev  APP_KEY=<32 random bytes>
#   MAIL_URL=smtp://...  (the site sends no mail; the framework still wants a transport)
